    <file alias="shaders/copy.frag">../shaders/copy.frag</file>
    <file alias="shaders/composite.frag">../shaders/composite.frag</file>
    <file alias="shaders/overlay.frag">../shaders/overlay.frag</file>
  </qresource>
</RCC>
