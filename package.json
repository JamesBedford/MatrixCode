{
  "name": "matrix-code",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Film-accurate Matrix digital rain — full-viewport WebGL2 effect",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wallpaper": "npm run build && node scripts/wallpaper-engine/package.mjs",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/MatrixCode/scripts/Build-Windows.ps1 -Architecture x64 -Configuration Release -SkipTests",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/MatrixCode/scripts/Install-ScreenSaver.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/MatrixCode/scripts/Verify-Windows.ps1 -Architecture x64 -Configuration Debug",
    "test:watch": "vitest",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/MatrixCode/scripts/Build-Release.ps1",
    "verify:wallpaper": "node scripts/wallpaper-engine/generate-project.mjs --check",
    "verify:parity": "./scripts/verify_parity.sh",
    "verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/MatrixCode/scripts/Verify-Windows.ps1 -Architecture x64 -Configuration Debug -Capture"
  },
  "dependencies": {
    "twgl.js": "^5.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.6"
  }
}
